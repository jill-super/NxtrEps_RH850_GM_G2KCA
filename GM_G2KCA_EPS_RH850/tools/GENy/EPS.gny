        &lt;SUBSERVICE qualifier="DID_DE_GMLAN_Identification_Data" id="0x0f1e82fc" active="true" actQual="ReadDid"&gt;
          &lt;CFGVARIANTREFS&gt;
            &lt;CFGVARIANTREF ref="0x15406144"/&gt;
          &lt;/CFGVARIANTREFS&gt;
          &lt;DESC&gt;This DID contains a 1 byte Bus Type, a 2 byte GMLAN Kernel, and a 3 byte value that represents the revision level of the GM serial data database file implemented on the specified network. This information shall be repeated for each GMLAN network to which the controller is connected. The length of the DID will be determined by the number of connected GMLAN networks, i.e. length is equal to 6 * n, where n is the number of connected GMLAN networks.&lt;/DESC&gt;
          &lt;ATTRIBUTE name="PacketHandlerSupport" value="None"/&gt;
          &lt;ATTRIBUTE name="MainHandlerSupport" value="User"/&gt;
          &lt;ATTRIBUTE name="PreHandlerSupport" value="None"/&gt;
          &lt;ATTRIBUTE name="PreHandlerOverrideName" value=""/&gt;
          &lt;ATTRIBUTE name="PostHandlerSupport" value="None"/&gt;
