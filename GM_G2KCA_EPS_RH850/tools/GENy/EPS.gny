          &lt;SUBSVCPROP funcreq="true" funcres="true" physreq="true" physres="true"/&gt;
          &lt;REQUEST&gt;
            &lt;PROTCOMPCOLREF ref="0x0f1cd92c"/&gt;
          &lt;/REQUEST&gt;
          &lt;RESPONSE&gt;
            &lt;DATACOMPCOLREF ref="0x15561e18"/&gt;
            &lt;PROTCOMPCOLREF ref="0x0f1cd92c"/&gt;
          &lt;/RESPONSE&gt;
          &lt;STATEMANAGER&gt;
            &lt;TRANSCOL&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x15452118"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1547a628"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1547a4b8"/&gt;
              &lt;/TRANS&gt;
