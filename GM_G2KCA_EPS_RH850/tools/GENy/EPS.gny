          &lt;ATTRIBUTE name="MayHaveSignals" value="true"/&gt;
          &lt;SUBSVCPROP funcreq="true" funcres="true" physreq="true" physres="true"/&gt;
          &lt;REQUEST&gt;
            &lt;PROTCOMPCOLREF ref="0x156534b4"/&gt;
          &lt;/REQUEST&gt;
          &lt;RESPONSE&gt;
            &lt;DATACOMPCOLREF ref="0x156553a8"/&gt;
            &lt;PROTCOMPCOLREF ref="0x156534b4"/&gt;
          &lt;/RESPONSE&gt;
          &lt;STATEMANAGER&gt;
            &lt;TRANSCOL&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd4b8"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd368"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
