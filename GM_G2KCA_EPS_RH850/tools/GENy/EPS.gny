              &lt;/TRANS&gt;
            &lt;/TRANSCOL&gt;
          &lt;/STATEMANAGER&gt;
          &lt;PROTCOMPCOLPOOL&gt;
            &lt;PROTCOMPCOL id="0x0f1ce21c"&gt;
              &lt;PROTCOMP qualifier="DID" itemlength="1" spec="id" maxvalue="255" value="240"/&gt;
            &lt;/PROTCOMPCOL&gt;
          &lt;/PROTCOMPCOLPOOL&gt;
