        &lt;SUBSERVICE qualifier="PID_4656_EPS_Motor_Current_State_of_Health" id="0x15621f6c" active="true" actQual="ReadPid"&gt;
          &lt;CFGVARIANTREFS&gt;
            &lt;CFGVARIANTREF ref="0x155bd254"/&gt;
          &lt;/CFGVARIANTREFS&gt;
