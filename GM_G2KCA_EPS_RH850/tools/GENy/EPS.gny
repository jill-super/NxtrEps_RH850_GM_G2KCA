                &lt;SRCSTATEREF ref="0x155bd368"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd560"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd608"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd6b0"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd758"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd800"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd8a8"/&gt;
              &lt;/TRANS&gt;
            &lt;/TRANSCOL&gt;
          &lt;/STATEMANAGER&gt;
          &lt;PROTCOMPCOLPOOL&gt;
            &lt;PROTCOMPCOL id="0x15652c74"&gt;
              &lt;PROTCOMP qualifier="DID" itemlength="1" spec="id" maxvalue="255" value="154"/&gt;
            &lt;/PROTCOMPCOL&gt;
          &lt;/PROTCOMPCOLPOOL&gt;
        &lt;/SUBSERVICE&gt;
        &lt;SUBSERVICE qualifier="DID_9F_Previous_Stored_Repair_Shop_Code_Or_Tester_Serial_Number" id="0x155f1e0c" active="true" actQual="ReadDid"&gt;
          &lt;CFGVARIANTREFS&gt;
            &lt;CFGVARIANTREF ref="0x155bd254"/&gt;
          &lt;/CFGVARIANTREFS&gt;
          &lt;DESC&gt;This DID contains the Previous Stored Repair Shop Code Or Tester Serial Numbers.  This data provides a mechanism for a tool user to identify up to the last two dealer codes or tester serial numbers programmed into DID $98.

Last Stored Repair Shop Code or Tester Serial Number
When a test tool writes a dealer code or tester serial number into DID $98, the data previously stored in DID $98 is copied (without additional tester intervention) into the module memory housing byte positions 0 through 9 of this DID.

Second from Last Stored Repair Shop Code or Tester Serial Number
When a test tool writes a dealer code or tester serial number into DID $98, the data previously in byte positions 0 through 9 of this DID are moved to positions 10 through 19.  The data previously stored in DID $98 are then copied into this DID in byte positions 0 through 9.&lt;/DESC&gt;
          &lt;ATTRIBUTE name="PacketHandlerSupport" value="None"/&gt;
          &lt;ATTRIBUTE name="MainHandlerSupport" value="User"/&gt;
          &lt;ATTRIBUTE name="PreHandlerSupport" value="None"/&gt;
          &lt;ATTRIBUTE name="PreHandlerOverrideName" value=""/&gt;
          &lt;ATTRIBUTE name="PostHandlerSupport" value="None"/&gt;
          &lt;ATTRIBUTE name="PostHandlerOverrideName" value=""/&gt;
          &lt;ATTRIBUTE name="NvmBlockDescriptor" value=""/&gt;
          &lt;ATTRIBUTE name="IoHwAbManaged" value="false"/&gt;
          &lt;ATTRIBUTE name="FingerprintType" value="None"/&gt;
          &lt;ATTRIBUTE name="MayHaveSignals" value="true"/&gt;
          &lt;SUBSVCPROP funcreq="true" funcres="true" physreq="true" physres="true"/&gt;
          &lt;REQUEST&gt;
            &lt;PROTCOMPCOLREF ref="0x15652ccc"/&gt;
          &lt;/REQUEST&gt;
          &lt;RESPONSE&gt;
            &lt;DATACOMPCOLREF ref="0x15654728"/&gt;
            &lt;PROTCOMPCOLREF ref="0x15652ccc"/&gt;
          &lt;/RESPONSE&gt;
          &lt;STATEMANAGER&gt;
            &lt;TRANSCOL&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd4b8"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd368"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd560"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd608"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x155bd6b0"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
