          &lt;/REQUEST&gt;
          &lt;RESPONSE&gt;
            &lt;DATACOMPCOLREF ref="0x155626d8"/&gt;
            &lt;PROTCOMPCOLREF ref="0x0f1cdc44"/&gt;
          &lt;/RESPONSE&gt;
          &lt;STATEMANAGER&gt;
            &lt;TRANSCOL&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x15452118"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1547a628"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1547a4b8"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1554ffc0"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1556eea0"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1556ef48"/&gt;
              &lt;/TRANS&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x1556eff0"/&gt;
